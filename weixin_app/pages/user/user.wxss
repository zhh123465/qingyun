/* 他人主页：纸白身份卡 + 深色横幅出血到卡边 + 全宽双按钮，统计行单行 */
.u-card { margin: 0 32rpx 20rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: var(--r-xl); padding: 32rpx 28rpx 28rpx; overflow: hidden; }
/* 深色横幅：heroBg 内联色铺满到卡边，上圆角随卡；白鹤/远山（白色剪影）只能待在深色区，高度不得 < 180rpx */
.u-hero { margin: -32rpx -28rpx 0; padding: 32rpx 28rpx 24rpx; border-radius: var(--r-xl) var(--r-xl) 0 0; position: relative; overflow: hidden; }
.u-head { display: flex; gap: 24rpx; align-items: flex-start; }
.u-ava { width: 104rpx; height: 104rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 600; flex-shrink: 0; position: relative; }
.u-main { flex: 1; min-width: 0; }
.u-name { display: block; font-size: 34rpx; font-weight: 600; letter-spacing: 0; color: #FFFFFF; line-height: 1.3; position: relative; }
.u-dep { display: block; font-size: 22rpx; color: rgba(255,255,255,.72); letter-spacing: 0; margin-top: 6rpx; position: relative; }
.u-bio { display: block; font-size: 24rpx; line-height: 1.62; color: rgba(255,255,255,.86); margin-top: 10rpx; text-wrap: pretty; position: relative; }
/* 统计行：WXML 里是 .u-hero-stats（原 .u-stats 无匹配节点，已改正），样式落到子 text 上 */
.u-hero-stats { display: flex; gap: 24rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid rgba(255,255,255,.22); position: relative; }
.u-hero-stats text { font-size: 22rpx; color: rgba(255,255,255,.82); letter-spacing: 0; white-space: nowrap; }
.u-acts { display: flex; gap: 16rpx; margin-top: 24rpx; }
.u-follow { flex: 1; height: 80rpx; border-radius: var(--r-full); background: var(--primary); color: #fff; font-size: 26rpx; font-weight: 600; letter-spacing: 0; display: flex; align-items: center; justify-content: center; transition: background-color .15s var(--ease), transform .12s var(--ease); }
.u-follow:active { transform: scale(.98); }
.u-follow.on { background: var(--primary-softer); color: var(--primary-deep); border: 2rpx solid var(--line); }
.u-dm { flex: 1; height: 80rpx; border-radius: var(--r-full); border: 2rpx solid var(--line); color: var(--primary-deep); font-size: 26rpx; font-weight: 600; letter-spacing: 0; display: flex; align-items: center; justify-content: center; transition: transform .12s var(--ease); }
.u-dm:active { transform: scale(.98); }
.u-foot { height: 60rpx; }
