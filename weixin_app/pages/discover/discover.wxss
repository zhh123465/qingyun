/* ===== 发现页作用域：只覆盖本页，避免污染其他复用同名类的页面 ===== */

/* 频道筛选：原型 JS display:none 的等价实现（CSS 多列自动回流）
   「无图帖」和「精选大图」同属生活/图文流，hide-photo 必须一并收起，否则筛选后仍会漏出 */
.discover-page .falls.hide-photo .fcard.photo,
.discover-page .falls.hide-photo .fcard.hero,
.discover-page .falls.hide-photo .fcard.text { display: none; }
.discover-page .falls.hide-qa .fcard.qa { display: none; }
.discover-page .falls.hide-doc .fcard.doc { display: none; }
.discover-page .falls.hide-chk .fcard.chk { display: none; }

/* 首屏纵向节奏：保留标题、搜索、AI、频道顺序和全部触控区，只压缩 AI 的内外留白 */
.discover-page .greet-title { margin-top: 0; }
/* 大标题行高收到 1.2 之后标题块更矮，搜索条要跟着往下让一点，否则挤在一起 */
.discover-page .head-tools { margin-top: 24rpx; }
/* 96rpx 单行条：只留外边距，内边距与高度交给基础类，别在这里改高度 */
.discover-page .ai-strip {
  margin: 20rpx 32rpx 8rpx;
}
.discover-page .falls { padding-top: 16rpx; }

/* 内容卡回到纸卡：边界交给 2rpx 描边，不再用阴影分层 */
.discover-page .fcard {
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--r-xl);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  transition: transform .18s var(--ease), opacity .18s var(--ease);
}
.discover-page .fcard.card-press {
  transform: scale(.97);
  opacity: .92;
}
/* 满宽大图按压收得更轻：整块 686rpx 的缩放幅度和小卡不该是同一个系数 */
.discover-page .fcard.hero.card-press {
  transform: scale(.985);
  opacity: .94;
}
.discover-page .fcard.wide { margin-top: 0; }

/* 药丸只承担导航提示，字号抬到辅助文字可读档 */
.discover-page .w-pill {
  height: auto;
  min-height: 48rpx;
  padding: 6rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
}
.discover-page .qtag { font-size: 22rpx; }

/* 频道结果反馈：只给筛选后的当前频道显示数量，不新增整行说明 */
.discover-page .itab {
  height: auto;
  min-height: 80rpx;
  padding: 16rpx 0 12rpx;
}
.discover-page .itab-count {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--primary-deep);
  letter-spacing: 0;
}
/* 搜索条用最小高度承载放大字体，不写死文本裁剪盒 */
.discover-page .nebula .nb-in {
  height: auto;
  min-height: 88rpx;
}

/* 扩大点击盒，不放大视觉图形；相邻热区保持间隙 */
.discover-page .avatar-btn::before {
  content: "";
  position: absolute;
  inset: -4rpx;
  border-radius: inherit;
}
.discover-page .itab::before {
  content: "";
  position: absolute;
  top: -8rpx;
  bottom: -8rpx;
  left: -16rpx;
  right: -16rpx;
}
.discover-page .nb-go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 88rpx;
}
.discover-page .nb-cancel {
  position: relative;
  z-index: 89;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-deep);
}
.discover-page .sd-chips { row-gap: 32rpx; }
.discover-page .sd-chip {
  position: relative;
}
.discover-page .sd-chip::before {
  content: "";
  position: absolute;
  inset: -14rpx -8rpx;
}
.discover-page .sd-r { min-height: 88rpx; }
.discover-page .sd-hd { align-items: center; }
.discover-page .sd-hd-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.discover-page .sd-clear {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -16rpx 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-deep);
}

/* 无结果兜底：不使用大面积空卡，保留可恢复入口 */
.discover-page .feed-empty {
  column-span: all;
  margin: 8rpx 0 24rpx;
  padding: 56rpx 32rpx;
  border-radius: var(--r-xl);
  background: var(--card);
  border: 2rpx solid var(--line);
  text-align: center;
}
.discover-page .feed-empty-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text1);
}
.discover-page .feed-empty-s {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-meta);
}
.discover-page .feed-empty-act {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 320px 小屏保护：双列读不清时降为单列，不靠缩字硬保密度 */
@media (max-width: 320px) {
  .discover-page .falls { column-count: 1; }
  .discover-page .fcard.photo .gcover { height: 320rpx !important; }
}

/* 留白、缩放和过场都尊重系统减弱动态效果 */
@media (prefers-reduced-motion: reduce) {
  .discover-page .fcard,
  .discover-page .card-press,
  .discover-page .ai-strip,
  .discover-page .itab,
  .discover-page .nb-in,
  .discover-page .nb-label {
    transition: none !important;
  }
  .discover-page .fcard.card-press { transform: none; opacity: 1; }
}
