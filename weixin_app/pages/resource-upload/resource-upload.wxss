@import "../../styles/form.wxss";
.pick-zone { margin: 32rpx 32rpx 0; height: 400rpx; border: 2rpx dashed var(--line); border-radius: var(--r-lg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: var(--text-meta); }
.pick-zone .icu-35 { width: 80rpx; height: 80rpx; }
.pz-t { font-size: 28rpx; font-weight: 600; color: var(--text2); }
.pz-s { font-size: 22rpx; padding: 0 60rpx; text-align: center; }
.file-card { display: flex; align-items: center; gap: 24rpx; }
.file-card .file-chip { width: 92rpx; height: 92rpx; border-radius: var(--r-lg); background: var(--primary-soft); color: var(--primary-deep); font-size: 22rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.fc-main { flex: 1; min-width: 0; }
.fc-name { font-size: 28rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fc-meta { font-size: 22rpx; color: var(--text-meta); margin-top: 6rpx; }
.fc-change { flex-shrink: 0; font-size: 24rpx; color: var(--primary-deep); font-weight: 600; }
.ok-c { color: var(--primary); }
.detect-row { display: flex; align-items: baseline; gap: 16rpx; padding: 20rpx 24rpx; background: var(--primary-softer); border-radius: var(--r-md); }
.d-course { font-size: 28rpx; font-weight: 600; color: var(--primary-deep); }
.d-chapter { font-size: 24rpx; color: var(--text2); flex: 1; }
.d-change { font-size: 22rpx; color: var(--text-meta); }
