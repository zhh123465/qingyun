@import "../../styles/form.wxss";
.rd-name { display: block; line-height: 1.45; }
.rd-uploader { margin: 0 32rpx 8rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: var(--r-lg); padding: 24rpx 28rpx; display: flex; align-items: center; gap: 20rpx; }
.ru-main { flex: 1; min-width: 0; }
.rd-preview { margin: 0 32rpx 8rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: var(--r-xl); padding: 28rpx; }
.rp-p { font-size: 28rpx; line-height: 1.62; color: var(--text1); margin-bottom: 20rpx; }
.rp-more { text-align: center; font-size: 22rpx; color: var(--text-meta); margin-top: 8rpx; }
/* 收藏：与帖子详情底栏同款横排动作（小星 + 文字同行） */
.rd-fav { flex-shrink: 0; display: flex; align-items: center; gap: 8rpx; height: 72rpx; padding: 0 26rpx; border-radius: var(--r-full); background: var(--bg); border: 2rpx solid var(--line); color: var(--text2); font-size: 22rpx; }
.rd-fav.on { color: var(--amber-deep); border-color: var(--amber); }
