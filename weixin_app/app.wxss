@import "styles/motifs.wxss";
@import "styles/circle-marks.wxss";

/* ============================================================
   青云 · 设计 Token 地基（一期重构）
   单位规则：实现值一律 rpx；px 仅描述设备物理指标
   间距网格：8rpx 基准，布局间距只允许 8/16/24/32/40/48/64
   ============================================================ */
page{
  /* 色彩：主色退回「点缀 + 动作」，语义色分工（-deep 档专供文字，实色只给图形/主色按钮） */
  --bg:#F6F7F4; --card:#FFFFFF; --line:#E8ECE8; --line-soft:#F0F3F0;
  --primary:#176B70; --primary-deep:#0F4F53;
  --primary-soft:#E9F1F0; --primary-softer:#F1F6F5;
  --ink:#263331; --ink-brush:#1F2C29;
  /* 灰阶：text1/2 内容层，text-meta 元信息（4.52:1 临界），text3 仅 placeholder/禁用 */
  --text1:#263331; --text2:#566360; --text-meta:#68746F; --text3:#93A09A;
  --amber:#E9A94F; --amber-deep:#9C5C00; --amber-soft:#FDF3E2;
  --coral:#E77961; --coral-deep:#B93F24; --coral-soft:#FCEDE8;
  --sky:#4353D9; --sky-deep:#3846BF; --sky-soft:#EDEFFA;
  --error:#C4442F; --paper:#FFFFFF; --mask:rgba(38,51,49,.38);
  /* 圆角体系（同心规则：外圆角 = 内圆角 + 内边距） */
  --r-xl:32rpx;   /* 页面大卡：瀑布流卡、帖子卡、sheet 面板 */
  --r-lg:24rpx;   /* 内嵌块：卡内图片、卡内子模块 */
  --r-md:16rpx;   /* 小组件：标签、chip、输入框内元素 */
  --r-sm:8rpx;    /* 微元素：角标、迷你标签 */
  --r-full:999rpx;/* 全圆：头像、药丸按钮、FAB */
  /* 间距网格：8rpx 基准，只允许 8/16/24/32/40/48/64；区之间 48，卡之间 24，卡内 28，行内 24 */
  --gap-page:32rpx; --gap-card:24rpx; --gap-block:48rpx;
  --pad-card:28rpx; --pad-row:24rpx;
  /* 阴影三级（替代「层级全押阴影」）
     一句话原则：卡靠 2rpx 描边分开；只有「这层浮在内容之上」才给阴影，且不超过两级。
     --shadow-card 的值就是 none，是「零阴影也是显式声明」，不是漏写。 */
  --shadow-card:none;
  --shadow-float:0 8rpx 32rpx rgba(20,50,50,.08);   /* tabbar、FAB、身份卡 */
  --shadow-sheet:0 16rpx 60rpx rgba(20,40,40,.10);  /* sheet、搜索弹窗、庆祝卡、toast */
  /* 全站唯二缓动：回弹曲线仅注册给点赞数字/FAB 按压等必须弹跳的反馈 */
  --ease:cubic-bezier(.16,1,.3,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);
  /* 字阶（编辑式排版，全站系统黑体栈；层级由 字号 × 字重 × 颜色 三轴承担，字距默认 0）：
     L1 44/600 页面大标题 · L2 34/600 帖子/问答/sheet 标题 · L3 28/600 卡片/区块标题
     L4 28/400 正文 · L5 24/400-500 辅助正文/评论 · L6 22/400 元信息
     L6-num 24/700 计数数字（tabular-nums 全局已开） */
  /* 光学字距：字号越大字距越紧（系统字体的 optical size 行为）。
     只作用于 ≥32rpx 的标题——28 以下收紧只会变糊，正文与元信息保持 0。 */
  --track-1:-1rpx;    /* 44rpx 以上 */
  --track-2:-.4rpx;   /* 32–34rpx */
}
view,text,input,page{margin:0;padding:0;box-sizing:border-box}
page{background:var(--bg);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;color:var(--text1);font-weight:400;letter-spacing:0;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}


.stage{position:relative}
.stage::-webkit-scrollbar{display:none}
.screen{display:none;padding-bottom:200rpx;animation:fadein .22s var(--ease)}
.screen.active{display:block}
@keyframes fadein{from{opacity:.4;transform:translateY(11rpx)}to{opacity:1;transform:none}}

/* 逐元素 stagger 入场（索引模式：元素上标 style="--i:N"）
   节奏：420ms 单次 + 60ms 步进，5 项以内总时长约 660ms。
   长列表不再逐项播放——超出的项改用 .rise-late 直接落位，读内容时画面已经静止。
   只动 transform/opacity，不触发重排。 */
.rise{animation:rise .42s var(--ease) both;animation-delay:calc(var(--i,0)*60ms)}
.rise-late{animation:none}
@keyframes rise{from{opacity:0;transform:translate3d(0,16rpx,0)}to{opacity:1;transform:none}}
/* reduced-motion 降级：关闭入场编排，功能与布局完整可用 */
@media (prefers-reduced-motion:reduce){
  .rise{animation:none}
  .screen{animation:none}
  .bubble,.dm-bub,.dm-bub-img-wrap,.row-ava{animation:none}
  .mine-nav{transition:none}
  /* 遮罩揭示关掉时必须整块撤走：只写 animation:none 会把它默认的 opacity:1 留在图上 */
  .hero-wrap::before{display:none}
}

/* 气泡入场（ai/chat/dm 新消息上浮淡入；进页首屏同播一次，.24s 不抢戏） */
.bubble,.dm-bub,.dm-bub-img-wrap,.row-ava{animation:bub-in .24s var(--ease) both}
@keyframes bub-in{from{opacity:0;transform:translate3d(0,10rpx,0)}to{opacity:1;transform:none}}

/* ===== 通用头（编辑式排版：L1 大标题 + L6 大字距小标签注脚） ===== */
.page-head{padding:40rpx 32rpx 0}
.head-row{display:flex;align-items:flex-start;justify-content:space-between}
.greet-sub{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.greet-title{font-size:48rpx;font-weight:600;line-height:1.2;letter-spacing:var(--track-1);margin-top:8rpx;text-wrap:balance;color:var(--ink-brush)}
.avatar-btn{width:80rpx;height:80rpx;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:600;position:relative;flex-shrink:0}
/* 头像位放真照片时铺满整圆；红点必须压在照片之上 */
.avatar-btn .ava-img{width:100%;height:100%;border-radius:50%;display:block}
.avatar-btn .dot{z-index:2}
.avatar-btn .dot{position:absolute;top:2rpx;right:2rpx;width:16rpx;height:16rpx;border-radius:50%;background:var(--error);border:4rpx solid var(--bg)}
.head-tools{display:flex;gap:16rpx;align-items:center;margin-top:24rpx}
.search-pill{flex:1;height:80rpx;border-radius:var(--r-full);background:var(--card);border:2rpx solid var(--line);display:flex;align-items:center;gap:16rpx;padding:0 8rpx 0 28rpx;font-size:24rpx;color:var(--text3);min-width:0}
.search-pill .se-ph{flex:1;min-width:0;letter-spacing:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.search-pill .se-go-mini{flex-shrink:0;height:64rpx;display:flex;align-items:center;padding:0 24rpx;border-left:2rpx solid var(--line);color:var(--primary-deep);font-weight:600;letter-spacing:0}
/* 原生输入框版搜索条：点击即聚焦弹键盘，不跳独立页面；字号 32rpx（可读性下限） */
.search-pill .se-native{flex:1;min-width:0;height:100%;font-size:32rpx;color:var(--text1);background:transparent}
.search-pill .se-ph-cls{color:var(--text3);opacity:.85;letter-spacing:0;font-size:32rpx}

/* ===== 发现页 ===== */
.channels{display:flex;gap:16rpx;padding:16rpx 32rpx 8rpx;overflow-x:auto;scrollbar-width:none}
.channels::-webkit-scrollbar{display:none}
.chip{flex-shrink:0;height:64rpx;padding:0 28rpx;border-radius:var(--r-full);font-size:24rpx;color:var(--text2);background:var(--card);border:2rpx solid var(--line);display:flex;align-items:center;transition:background-color .15s var(--ease),color .15s var(--ease),border-color .15s var(--ease),transform .12s var(--ease)}
.chip:active{transform:scale(.96)}
.chip.on{background:var(--primary);color:#fff;border-color:var(--primary);font-weight:600}

/* 墨笔触 tab（契约 2：SVG 手绘笔触、两端细中间粗、高 6rpx、仅选中项显示；
   DO NOT：不改实心药丸、不用等宽矩形替代、不加背景/描边/投影） */
.itabs{display:flex;gap:40rpx;padding:8rpx 32rpx 0;overflow-x:auto;scrollbar-width:none}
.itabs::-webkit-scrollbar{display:none}
.itab{flex-shrink:0;position:relative;height:80rpx;display:flex;align-items:center;gap:8rpx;font-size:28rpx;color:var(--text-meta);transition:color .2s var(--ease)}
.itab.on{color:var(--text1);font-weight:600}
.itab.on::after{content:"";position:absolute;left:2rpx;right:2rpx;bottom:8rpx;height:6rpx;background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20120%206%22%20preserveAspectRatio%3D%22none%22%3E%3Cpath%20d%3D%22M3%204.4C20%201.6%2044%205.2%2064%203.2C84%201.4%20104%204.8%20117%203.6C117.8%204.4%20117.6%205%20116.4%205.1C88%205.9%2042%205.6%204.5%205.3C2.8%205.2%202.4%204.9%203%204.4Z%22%20fill%3D%22%23175A67%22%2F%3E%3C%2Fsvg%3E");background-repeat:no-repeat;background-size:100% 100%}

/* 混合流：图文双列（图片要密度），问答/资料/打卡跨列全宽（文字要宽度） */
.falls{column-count:2;column-gap:16rpx;padding:24rpx 32rpx 0}
.fcard{break-inside:avoid;margin-bottom:24rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);overflow:hidden}
.fcard .cover{width:100%;display:block;background:var(--primary-softer)}
.fcard .body{padding:24rpx}
.f-title{font-size:28rpx;font-weight:600;line-height:1.42;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.f-meta{margin-top:16rpx;display:flex;align-items:center;gap:8rpx}
.f-count{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.badge{position:absolute;top:16rpx;left:16rpx;height:40rpx;padding:0 16rpx;border-radius:var(--r-full);background:rgba(255,255,255,.94);border:2rpx solid var(--line);color:var(--text2);font-size:20rpx;font-weight:600;display:flex;align-items:center}
/* 精华标：浅琥珀底 + 深琥珀字（amber 实色 2.05:1 不得做文字），不做光带、不做毛玻璃 */
.badge.hot{background:var(--amber-soft);border:2rpx solid rgba(233,169,79,.45);color:var(--amber-deep);font-weight:600}
.cover-wrap{position:relative}
/* 封面系统：
   有图 → .gcover.gcover-photo + <image mode="aspectFill">；
   无图 → .gcover.cv-*，浅纯色打底 + 细云纹 SVG 压到 .3。
   演示内容现已全部换成真实照片，.cv-* 保留给接口返回无图时的兜底，不要删。 */
.gcover{position:relative;width:100%;overflow:hidden;background-color:#F1F4F1}
.gcover::after{content:"";position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22200%22%20height%3D%22120%22%20viewBox%3D%220%200%20200%20120%22%20fill%3D%22none%22%3E%3Cg%20stroke%3D%22%23FFFFFF%22%20stroke-opacity%3D%22.32%22%20stroke-width%3D%221.5%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M26%2078a9%209%200%201%201%209-9%207%207%200%201%201-7%207%205%205%200%201%201%205-5%22%2F%3E%3Cpath%20d%3D%22M96%2054a11%2011%200%201%201%2011-11%208.5%208.5%200%201%201-8.5%208.5%206%206%200%201%201%206-6%22%2F%3E%3Cpath%20d%3D%22M160%2088a8%208%200%201%201%208-8%206%206%200%201%201-6%206%22%2F%3E%3Cpath%20d%3D%22M12%20104h176%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E");background-repeat:no-repeat;background-position:right 6% bottom 10%;background-size:72% auto;opacity:.3;pointer-events:none}
.cv-sunset{background-color:#FAF0E4}
.cv-library{background-color:#EAF1F4}
.cv-ginkgo{background-color:#F8F1DC}
.cv-algo{background-color:#EAF2EC}
/* 真实照片封面：与纯色封面共用尺寸，但不叠云纹——白线压在照片上只会糊成噪点。
   底色调到比 --card 略深一档，图片解码前的空档不会闪白。 */
.gcover-photo{display:block;background-color:#E4E9E4;object-fit:cover}
.gcover-photo::after{display:none}
/* 跨列宽卡 */
.fcard.wide{column-span:all;display:flex;align-items:center;gap:24rpx;padding:24rpx;margin-top:8rpx;margin-bottom:24rpx}
.fcard.wide .w-main{flex:1;min-width:0}
.fcard.wide .w-side{flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:8rpx}
.w-pill{height:48rpx;padding:0 24rpx;border-radius:var(--r-full);font-size:22rpx;display:flex;align-items:center;font-weight:500}
.w-pill.ans{background:var(--primary-softer);color:var(--primary-deep)}
.w-pill.dl{background:var(--primary-softer);color:var(--primary-deep)}
.w-pill.go{background:var(--primary);color:#fff;font-weight:600}
/* 问答宽卡：纯文字大卡即封面（无图不硬凑图，彻底去掉封面区），标题直接排版 */
.fcard.qa.wide .qtag{margin:0 0 8rpx}
.fcard.qa.wide .f-title{font-size:28rpx;-webkit-line-clamp:2}
.fcard.doc.wide .file-chip{margin:0;width:96rpx;height:96rpx;font-size:22rpx;flex-shrink:0}
.fcard.chk.wide .chk-ring{margin:0;flex-shrink:0}
.fcard.chk.wide .chk-info{min-width:0}
.fcard.chk.wide .chk-note{font-size:24rpx;color:var(--text2);margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* 无图帖：不造封面区。以前拿 224rpx 空白纹理当图片，等于用「像图片」冒充图片，
   读起来是空的。这里让排版自己承担密度：
   22rpx 分类标签 → 28/600 标题 → 24/400 两行摘要 → 头像 + 昵称 + 时间。 */
.fcard.text .body{padding:26rpx 24rpx 22rpx}
.ftag{display:inline-block;font-size:22rpx;font-weight:500;line-height:1.2;letter-spacing:0;color:var(--primary-deep);background:var(--primary-softer);border-radius:var(--r-sm);padding:5rpx 14rpx}
.fcard.text .f-title{margin-top:14rpx}
.f-sum{margin-top:10rpx;font-size:24rpx;line-height:1.6;color:var(--text2);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.f-author{margin-top:18rpx;display:flex;align-items:center;gap:10rpx;min-width:0}
.f-author .fa-img{width:36rpx;height:36rpx;border-radius:50%;display:block;flex-shrink:0;background:var(--primary-soft)}
.f-author .fa-name{font-size:22rpx;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.f-author .fa-time{font-size:22rpx;color:var(--text-meta);letter-spacing:0;flex-shrink:0;margin-left:auto}

/* 今日精选：跨列 16:9 真图，标题压在图上。
   底部的墨色渐变是可读性前提（白字压在照片的高光上会糊），不是装饰；
   渐变挂在 .hero-wrap 上，因为 .fcard 的 overflow:hidden 会裁掉自己的伪元素。 */
.fcard.hero{column-span:all;padding:0;margin-bottom:24rpx}
.hero-wrap{position:relative;padding-top:56.25%;background-color:#E4E9E4;overflow:hidden}
.hero-img{position:absolute;left:0;top:0;width:100%;height:100%;display:block}
/* 轻微遮罩揭示：卡片升起后白幕再退，图像像「显影」一样出来。
   延迟 .3s 是为了不跟 .rise 的 240ms 起步撞车——早于卡片出现就白做了。 */
.hero-wrap::before{content:"";position:absolute;left:0;top:0;right:0;bottom:0;z-index:3;background:var(--card);animation:hero-veil .7s var(--ease) .3s both;pointer-events:none}
@keyframes hero-veil{from{opacity:.82}to{opacity:0}}
.hero-wrap::after{content:"";position:absolute;left:0;top:0;right:0;bottom:0;z-index:1;background:linear-gradient(180deg,rgba(12,26,29,0) 30%,rgba(12,26,29,.40) 62%,rgba(12,26,29,.88) 100%);pointer-events:none}
.hero-txt{position:absolute;left:28rpx;right:28rpx;bottom:24rpx;z-index:2}
.hero-tag{display:inline-block;font-size:20rpx;font-weight:600;line-height:1.2;letter-spacing:1rpx;color:#fff;background:rgba(255,255,255,.20);border:2rpx solid rgba(255,255,255,.46);border-radius:var(--r-sm);padding:5rpx 12rpx}
.hero-title{margin-top:12rpx;font-size:32rpx;font-weight:600;line-height:1.26;letter-spacing:var(--track-2);color:#fff;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.hero-meta{margin-top:10rpx;font-size:22rpx;color:rgba(255,255,255,.86);letter-spacing:0}
/* 问答卡（窄列旧样式保留给筛选态） */
.qmark{width:56rpx;height:56rpx;border-radius:var(--r-md);background:var(--sky);color:#fff;font-weight:600;font-size:28rpx;display:flex;align-items:center;justify-content:center;margin-bottom:16rpx}
.qtag{display:inline-block;font-size:22rpx;font-weight:500;color:var(--primary-deep);background:var(--primary-softer);border-radius:var(--r-sm);padding:4rpx 16rpx;margin-bottom:16rpx}
/* 资料卡 */
.file-chip{width:72rpx;height:72rpx;border-radius:var(--r-lg);background:var(--primary-soft);color:var(--primary-deep);font-size:22rpx;font-weight:600;display:flex;align-items:center;justify-content:center;margin-bottom:16rpx}
/* 打卡卡 */
.chk-ring{display:flex;align-items:center;gap:20rpx;margin-bottom:16rpx}
.chk-info ._b{font-size:24rpx;font-weight:500;display:block}
.chk-info ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
/* AI 学伴入口：96rpx 单行条（图标 + 品牌名 + 能力短句 + 实色小药丸）。
   长示例问题不在这里——它归 AI 页首屏，不该占掉发现页的第一屏主角位。 */
.ai-strip{position:relative;overflow:hidden;display:flex;align-items:center;height:96rpx;margin:28rpx 32rpx 16rpx;padding:0 16rpx 0 24rpx;border-radius:var(--r-lg);background:var(--primary-softer);border:2rpx solid #DCE7E5;transition:transform .18s var(--ease)}
/* 96rpx 条里放不下 200rpx 的云纹衬底——裁出来只剩两团乱线，直接不加 */
.ai-top{position:relative;z-index:1;flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.ai-mark{display:flex;align-items:center;gap:10rpx;min-width:0}
.ai-mark .icu-3{width:26rpx;height:26rpx;flex-shrink:0;background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2219%22%20height%3D%2219%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230F454F%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%203l1.8%204.6L18.5%209.4l-4.7%201.8L12%2015.8l-1.8-4.6L5.5%209.4l4.7-1.8z%22%2F%3E%3C%2Fsvg%3E")}
.ai-mark .icu-ai{width:28rpx;height:28rpx}
.ai-label{font-size:24rpx;font-weight:600;letter-spacing:0;color:var(--primary-deep);flex-shrink:0}
.ai-go{position:relative;overflow:hidden;flex-shrink:0;height:48rpx;padding:0 24rpx;border-radius:var(--r-full);background:var(--primary);color:#fff;font-size:22rpx;font-weight:600;letter-spacing:0;display:flex;align-items:center}
/* 能力短句：22rpx 元信息档，只提示「能干什么」，不展示完整提问 */
.ai-sub{font-size:22rpx;color:var(--text-meta);letter-spacing:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* 示例问题句：AI 页首屏用它举例，这里只是同一套字号，避免两处各写一套 */
.ai-prompt{position:relative;z-index:1;margin-top:14rpx;display:block;font-size:28rpx;line-height:1.45;font-weight:600;letter-spacing:0;color:var(--ink-brush);text-wrap:balance}

/* ===== 圈子页 ===== */
.sec-title{padding:48rpx 32rpx 24rpx;display:flex;align-items:baseline;justify-content:space-between}
.sec-title ._b{font-size:28rpx;font-weight:600;color:var(--ink-brush)}
.sec-title ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
/* 区块操作位：可点文字，未读清空后降为灰阶不可点感 */
.sec-title .sec-act{font-size:22rpx;color:var(--primary-deep);font-weight:500;letter-spacing:0;padding:16rpx 0 16rpx 24rpx}
.sec-title .sec-act.muted{color:var(--text3);font-weight:400}
.my-circles{display:flex;gap:20rpx;overflow-x:auto;padding:24rpx 32rpx 8rpx;scrollbar-width:none}
.my-circles::-webkit-scrollbar{display:none}
/* 槽宽 120rpx：22rpx 的「算法自习室」正好 110rpx，104 会把名字截成「算法自…」 */
.mc{flex-shrink:0;width:120rpx;text-align:center;position:relative}
.mc .cc{width:104rpx;height:104rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto;background-color:var(--primary-softer);border:2rpx solid #E1EAE8;color:var(--primary-deep);font-size:32rpx;font-weight:600}
/* 圆圈里只剩一个图形：图形 44rpx，留 30rpx 净空，比单字更像「标识」而不是「首字」 */
.mc .cc .cm{width:44rpx;height:44rpx}
.mc ._p{font-size:22rpx;color:var(--text2);margin-top:12rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mc .dot{position:absolute;top:2rpx;right:14rpx;width:16rpx;height:16rpx;background:var(--error);border-radius:50%;border:4rpx solid var(--bg)}
.hot-circles{display:flex;gap:24rpx;overflow-x:auto;padding:4rpx 32rpx 16rpx;scrollbar-width:none}
.hot-circles::-webkit-scrollbar{display:none}
.hcard{flex-shrink:0;width:432rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);overflow:hidden}
/* 深色块收缩：整块封面降级为 72rpx 顶栏（内联 {{item.cover}} 继续生效），重心回到白底描述 + 加入按钮 */
/* 热门圈子封面：真照片 + 底部墨色渐变托住白字。
   72rpx 的色条认不出圈子，但直接铺照片白字会糊——渐变是这里的可读性前提，不是装饰。 */
.hcard .hc-cover{height:200rpx;position:relative;overflow:hidden;background-color:#E4E9E4}
.hcard .hc-cover::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,26,29,0) 28%,rgba(12,26,29,.38) 60%,rgba(12,26,29,.82) 100%);pointer-events:none}
.hcard .hc-img{width:100%;height:100%;display:block}
.hcard .hc-name{position:absolute;left:24rpx;right:24rpx;bottom:18rpx;z-index:1;color:#fff;font-size:28rpx;font-weight:600;letter-spacing:0}
.hcard .hc-body{padding:22rpx 24rpx 20rpx}
.hcard ._p{font-size:24rpx;color:var(--text2);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.hc-meta{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx}
.hc-meta ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
/* 加入按钮：实色主色（6 段渐变 + inset 高光下线），次态改浅青底 + 深青字 */
.join-pill{height:52rpx;padding:0 24rpx;border-radius:var(--r-full);background:var(--primary);color:#fff;font-size:22rpx;font-weight:600;letter-spacing:0;display:flex;align-items:center;position:relative;overflow:hidden}
.join-pill.joined{background:var(--primary-softer);color:var(--primary-deep);border:2rpx solid var(--line)}
.feed-row{margin:0 32rpx 16rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-lg);padding:24rpx;display:flex;gap:20rpx;align-items:center}
.feed-row .fr-thumb{width:96rpx;height:96rpx;border-radius:var(--r-md);object-fit:cover;flex-shrink:0}
.feed-row .fr-info{flex:1;min-width:0}
.feed-row ._b{font-size:24rpx;font-weight:500;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.feed-row ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.circle-tag{font-size:22rpx;font-weight:500;color:var(--primary-deep);background:var(--primary-softer);border-radius:var(--r-sm);padding:4rpx 12rpx;flex-shrink:0}

/* ===== 消息页 ===== */
/* 三张 icard → 一条统计栏：行容器给卡底 + 2rpx 描边 + 24rpx 圆角，格间只用 2rpx 竖线（flex 列宽不变形） */
.interact-row{display:flex;align-items:stretch;margin:24rpx 32rpx 0;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);overflow:hidden}
.icard{flex:1;min-height:120rpx;background:transparent;border-radius:0;box-shadow:none;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;flex-wrap:nowrap;position:relative}
/* 三格之间的竖线同样内缩：通到上下描边就成了「表格」，缩进 20rpx 才像一个整块里的分区 */
.icard+.icard::before{content:"";position:absolute;left:0;top:20rpx;bottom:20rpx;width:2rpx;background:var(--line);pointer-events:none}
/* 数字与标签竖排、去掉彩色圆底：三个柔和色块是这套界面里最「玩具感」的东西，
   iOS 的统计块只靠字阶和发丝线分层。数字等宽，跳动时不抖。 */
.icard ._b{font-size:36rpx;font-weight:600;line-height:1.1;color:var(--ink-brush);font-variant-numeric:tabular-nums;letter-spacing:var(--track-2)}
.icard ._s{font-size:22rpx;color:var(--text-meta);line-height:1.4;letter-spacing:0;white-space:nowrap}
/* 320px 窄屏退化方向是「升一档字」而不是缩字（rpx 等比缩放不会溢出，损失的是物理尺寸） */
@media (max-width:320px){
  .icard ._s{font-size:24rpx}
  .icard ._b{font-size:34rpx}
  .icard{gap:6rpx}
}
.convs{margin:8rpx 32rpx 0;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);overflow:hidden}
.conv{display:flex;gap:24rpx;padding:20rpx 24rpx;align-items:center;position:relative}
/* 分隔线用伪元素而不是 border：只有这样才能从内容起点（头像之后）起笔，
   不顶到卡片两端。整行画满会让「分组」读成「表格」。 */
.conv::after{content:"";position:absolute;left:144rpx;right:0;bottom:0;height:2rpx;background:var(--line-soft);pointer-events:none}
.conv:last-child::after{display:none}
/* 首末行比中间行高 4rpx：整组读起来才是一个「块」，而不是被裁断的表格 */
.conv:first-child{padding-top:24rpx}
.conv:last-child{padding-bottom:24rpx}
.conv:active{background:#F1F4F1}
.conv .cv{width:96rpx;height:96rpx;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:600}
.conv .ci{flex:1;min-width:0}
/* 名字与时间同行右对齐（时间不占独立行）；未读角标由数据控制，读后清除 */
.conv .ct{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.conv .ct ._b{font-size:24rpx;font-weight:500;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.conv .ct ._em{font-style:normal;flex-shrink:0;font-size:22rpx;color:var(--text-meta);font-weight:400;letter-spacing:0}
.conv .ci ._p{font-size:24rpx;color:var(--text2);margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* 未读会话行第一步：名字加粗到 600、摘要提到 --text1（文字层先分层，底色是第二步） */
.conv.is-unread .ct ._b{font-weight:600;color:var(--text1)}
.conv.is-unread .ci ._p{color:var(--text1)}
/* 未读行只有一层极浅青底：加粗字重 + 角标已经足够分辨。
   原先那条 4rpx 竖色标是把三行连成一条「选中栏」，读起来像列表控件被选中，
   不像 iOS 的未读态——所以撤掉。 */
.conv.is-unread{background:#F1F7F5}
/* 按压态必须比未读底更深一档，否则未读行按下去毫无反馈 */
.conv.is-unread:active,.conv.is-unread.press-conv{background:#E8F1EF}
/* 未读语义收口：普通未读数 = 主色胶囊白字；仅 @/系统告警保留红色 */
.conv .unread{min-width:36rpx;height:36rpx;padding:0 12rpx;border-radius:var(--r-full);background:var(--primary);color:#fff;font-size:20rpx;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0}

/* ===== 我的（覆盖页） ===== */
.overlay{position:absolute;inset:0;background:var(--bg);z-index:60;transform:translateX(100%);transition:transform .28s var(--ease);overflow-y:auto;display:none}
.overlay.show{display:block;transform:translateX(100%)}
.overlay.in{transform:translateX(0)}
/* 身份卡：深色只留「头像横幅」（≈196rpx），统计落到卡内白条上（墨字比白字清楚）
   白鹤/远山是白色剪影，只能活在深色区 —— 横幅高度不得 < 180rpx，鹤停靠位 top:100rpx 与尺寸 94×66rpx 不动 */
.idcard{margin:32rpx;background:var(--primary);border-radius:var(--r-xl);padding:24rpx;color:#fff;position:relative;overflow:hidden;box-shadow:var(--shadow-float)}
.idcard .arcs{position:absolute;right:1rpx;bottom:1rpx;opacity:.5}
.idcard .row1{display:flex;align-items:center;gap:24rpx;position:relative;min-height:132rpx;padding-bottom:16rpx}
.idcard .id-scape{bottom:106rpx;height:110rpx}
.idcard .bigava{width:104rpx;height:104rpx;border-radius:50%;background:rgba(255,255,255,.16);border:2rpx solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:600}
.idcard ._h2{font-size:34rpx;font-weight:600;letter-spacing:0}
.idcard .meta{font-size:22rpx;color:rgba(255,255,255,.72);margin-top:4rpx;letter-spacing:0}
.idcard .sid{margin-top:16rpx;display:inline-flex;font-size:22rpx;color:#EAFFF6;background:rgba(255,255,255,.18);border-radius:var(--r-md);padding:4rpx 16rpx;letter-spacing:0}
.idcard .stats{display:flex;margin:32rpx -24rpx -24rpx;padding:20rpx 24rpx;position:relative;background:var(--card);border-top:2rpx solid var(--line);border-radius:0 0 32rpx 32rpx}
.idcard .stats .sv{flex:1;text-align:center}
.idcard .stats ._b{font-size:26rpx;font-weight:700;letter-spacing:0;color:var(--text1);display:block}
.idcard .stats ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.heat{margin:0 32rpx 28rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);padding:28rpx}
.heat ._h3{font-size:28rpx;font-weight:600;display:flex;justify-content:space-between;align-items:baseline}
.heat ._h3 ._s{font-size:22rpx;color:var(--text-meta);font-weight:400;letter-spacing:0}
/* 连续天数：这一格数字是打卡页唯一值得「大一点」的东西——标签读，数字看 */
.heat .hh-rt{display:flex;align-items:baseline;gap:6rpx;flex-shrink:0}
.heat .hh-sub{font-size:22rpx;color:var(--text-meta);font-weight:400;letter-spacing:0}
.heat .hh-n{font-size:34rpx;font-weight:600;line-height:1;color:var(--primary-deep);letter-spacing:0;font-variant-numeric:tabular-nums}
.heat .ht-body{display:flex;margin-top:24rpx}
.heat .ht-side{flex-shrink:0;width:32rpx;margin-right:12rpx}
.heat .ht-side ._s{display:block;height:16rpx;line-height:12rpx;font-size:14rpx;color:var(--text3)}
.heat .ht-grid{flex:1;display:flex}
.heat .ht-col{flex:1;display:flex;flex-direction:column}
.heat .ht-col+.ht-col{margin-left:4rpx}
.heat .ht-c{width:100%;height:12rpx;margin-bottom:4rpx;border-radius:2rpx;background:var(--primary-softer)}
.heat .ht-col .ht-c:last-child{margin-bottom:0}
.heat .ht-c.today{background:var(--primary);animation:twinkle 1.2s var(--ease) infinite}
@keyframes twinkle{0%,100%{opacity:1}50%{opacity:.55}}
/* 列轴是「词」（去年10月/1月/本周）不是刻度符号，抬到 22rpx；行轴 .ht-side 是单字刻度，保持 14rpx */
.heat .ht-x{display:flex;justify-content:space-between;font-size:22rpx;color:var(--text-meta);margin-top:8rpx;padding-left:44rpx}
.heat ._i.l1{background:#D7E6E4}.heat ._i.l2{background:#8FBDBB}.heat ._i.l3{background:var(--primary)}.heat ._i.l4{background:var(--primary-deep)}
.ach-scroll{display:flex;gap:16rpx;overflow-x:auto;padding:4rpx 32rpx 16rpx;scrollbar-width:none}
.ach-scroll::-webkit-scrollbar{display:none}
.ach{flex-shrink:0;width:188rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-lg);padding:24rpx;text-align:center}
.ach .medal{width:72rpx;height:72rpx;margin:0 auto 16rpx;border-radius:50%;background:var(--amber-soft);display:flex;align-items:center;justify-content:center}
.ach ._b{font-size:24rpx;font-weight:500;display:block}
.ach ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.ach.lock{opacity:.45}
.mlist{margin:8rpx 32rpx 56rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);overflow:hidden}
.mrow{display:flex;align-items:center;gap:24rpx;padding:28rpx;font-size:28rpx;position:relative}
.mrow::after{content:"";position:absolute;left:88rpx;right:0;bottom:0;height:2rpx;background:var(--line-soft);pointer-events:none}
.mrow:last-child::after{display:none}
.mrow:first-child{padding-top:32rpx}
.mrow:last-child{padding-bottom:32rpx}
.mrow svg{flex-shrink:0}
.mrow .arr{margin-left:auto}
.mrow-badge{min-width:32rpx;height:32rpx;padding:0 10rpx;border-radius:var(--r-full);background:var(--primary);color:#fff;font-size:20rpx;font-weight:600;display:inline-flex;align-items:center;justify-content:center;letter-spacing:0;margin-right:8rpx;vertical-align:middle}
.mine-nav{position:sticky;top:env(safe-area-inset-top);z-index:60;display:flex;align-items:center;gap:16rpx;padding:24rpx 28rpx 14rpx}
.mine-nav{transition:transform .3s var(--ease),opacity .3s var(--ease)}
.mine-nav.nav-hide{transform:translateY(-130%);opacity:0;pointer-events:none}
.mine-back{position:relative;width:72rpx;height:72rpx;border-radius:50%;background:var(--card);border:2rpx solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--primary-deep);transition:transform .12s var(--ease),border-color .15s var(--ease)}
.mine-back::after{content:"";position:absolute;inset:-8rpx;border-radius:50%}
.mine-nav ._s{font-size:28rpx;font-weight:600;color:var(--text2)}

/* ===== 圈子详情 / 全部圈子（覆盖层） ===== */
.cd-hero{margin:24rpx 32rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);padding:28rpx;display:flex;gap:24rpx;align-items:center}
.cd-cover{width:96rpx;height:96rpx;border-radius:var(--r-lg);color:#fff;font-size:36rpx;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cd-main{flex:1;min-width:0}
.cd-main ._b{font-size:28rpx;display:block;font-weight:600}
.cd-main ._p{font-size:24rpx;color:var(--text2);margin-top:4rpx;line-height:1.5}
.cd-stats{display:flex;gap:8rpx;margin-top:12rpx;font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.cd-join{margin-left:auto;flex-shrink:0;height:64rpx;padding:0 28rpx;border-radius:var(--r-full);background:var(--primary);color:#fff;font-size:24rpx;font-weight:600;border:none;position:relative;overflow:hidden}
.cd-join.joined{background:var(--primary-softer);color:var(--primary-deep);border:2rpx solid var(--line)}
/* 槽式分段控件：中性浅底槽 + 白色活动块（白块 + 2rpx 描边，不靠阴影浮起） */
.seg{display:flex;gap:4rpx;padding:6rpx;margin:0 32rpx 24rpx;background:#F0F3F0;border-radius:var(--r-full)}
.seg-t{flex:1;height:60rpx;border-radius:var(--r-full);background:transparent;font-size:24rpx;color:var(--text2);display:flex;align-items:center;justify-content:center;transition:background-color .15s var(--ease),color .15s var(--ease)}
.seg-t.on{background:var(--card);border:2rpx solid var(--line);color:var(--primary-deep);font-weight:600}
.cd-empty{margin:8rpx 32rpx;padding:48rpx 0;text-align:center;color:var(--text-meta);font-size:24rpx;background:var(--card);border:2rpx dashed var(--line);border-radius:var(--r-xl)}
.fi-chip{font-size:22rpx;font-weight:600}
.all-chips{display:flex;gap:16rpx;padding:24rpx 32rpx 16rpx;overflow-x:auto;scrollbar-width:none}
.all-chips::-webkit-scrollbar{display:none}
.all-list{padding:8rpx 32rpx 56rpx}
.ac-row{display:flex;gap:24rpx;align-items:center;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);padding:24rpx;margin-bottom:16rpx}
.ac-ava{width:84rpx;height:84rpx;border-radius:var(--r-lg);background-color:var(--primary-softer);border:2rpx solid #E1EAE8;color:var(--primary-deep);font-size:32rpx;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ac-ava .cm{width:44rpx;height:44rpx}
.ac-main{flex:1;min-width:0}
.ac-main ._b{font-size:24rpx;font-weight:500;display:block}
.ac-main ._p{font-size:22rpx;color:var(--text-meta);margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:0}
.ac-join{flex-shrink:0;height:56rpx;padding:0 24rpx;border-radius:var(--r-full);font-size:22rpx;font-weight:600;display:flex;align-items:center;background:var(--primary);color:#fff;position:relative;overflow:hidden}
.ac-join.joined{background:var(--primary-softer);color:var(--primary-deep);border:2rpx solid var(--line)}

/* ===== 私信（iMessage 风：与 AI 页刻意区分） ===== */
/* 导航不画分隔线：页头纯白、会话区纸灰，颜色本身已经分层，
   再加一条线就成了「工具条」，这是这两个页面此前最像微信而不是 iOS 的地方 */
.dm-head{background:rgba(255,255,255,.92);-webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx);display:flex;align-items:center;padding:16rpx 24rpx;flex-shrink:0}
.dm-back{position:relative;width:72rpx;height:72rpx;border-radius:50%;background:var(--card);border:2rpx solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--primary-deep);flex-shrink:0;transition:transform .12s var(--ease),border-color .15s var(--ease)}
.dm-back::after{content:"";position:absolute;inset:-8rpx;border-radius:50%}
.dm-mid{flex:1;display:flex;align-items:center;justify-content:center;gap:16rpx;min-width:0}
.dm-mid .av{width:56rpx;height:56rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600;flex-shrink:0}
.dm-mid ._b{font-size:28rpx;font-weight:600}
.dm-mid .on{width:12rpx;height:12rpx;border-radius:50%;background:var(--primary);flex-shrink:0}
.dm-right{width:72rpx;flex-shrink:0}
/* 私信页三段式布局：头部/消息区/输入条，输入条永远贴底 */

/* 会话区比全局纸色再深一档：白气泡压在 #F6F7F4 上几乎看不出边界，
   iOS 的会话底也是比白更沉一档的灰（#F2F2F7），气泡才「浮」得起来 */
.dm-body{flex:1;overflow-y:auto;scrollbar-width:none;background:#F2F4F1;padding:20rpx 24rpx 32rpx}
.dm-body::-webkit-scrollbar{display:none}
.dm-date{text-align:center;margin:24rpx 0 20rpx}
.dm-date ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.dm-mrow{display:flex;margin-bottom:16rpx;align-items:flex-end;gap:16rpx}
.dm-mrow.dm-out{justify-content:flex-end}
.dm-ava{width:56rpx;height:56rpx;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:600;overflow:hidden}
.dm-ava img{width:100%;height:100%;border-radius:50%;object-fit:cover}
/* 气泡：主圆角 34rpx，指向头像的下角收成 10rpx；无描边、无投影 */
.dm-bub{max-width:72%;padding:16rpx 26rpx;font-size:30rpx;line-height:1.5;border-radius:34rpx;text-wrap:pretty}
.dm-in .dm-bub{background:var(--card);border-bottom-left-radius:10rpx}
.dm-out .dm-bub{background:linear-gradient(180deg,#1B787D 0%,#156167 100%);color:#fff;border-bottom-right-radius:10rpx;letter-spacing:0}
/* 「已读」右缘对齐气泡右缘（不顶到头像）：气泡右边界 = 容器右 − 头像 56rpx − 间隙 16rpx */
.dm-read{font-size:22rpx;color:var(--text-meta);text-align:right;margin:0 72rpx 12rpx 0;letter-spacing:0}
.dm-bar{background:rgba(255,255,255,.94);-webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx);border-top:1rpx solid var(--line);display:flex;align-items:center;gap:16rpx;padding:14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));flex-shrink:0}
.dm-plus{position:relative;width:68rpx;height:68rpx;border-radius:50%;background:#F2F4F1;display:flex;align-items:center;justify-content:center;color:var(--text2);flex-shrink:0;transition:transform .12s var(--ease)}
.dm-plus::after{content:"";position:absolute;inset:-12rpx;border-radius:50%}
.dm-plus:active{transform:scale(.94)}
/* 输入药丸：输入框去描边、发送键收进药丸右侧，空态灰箭头、有字才亮成主色 */
.dm-pill{flex:1;min-width:0;display:flex;align-items:center;height:84rpx;border-radius:var(--r-full);background:#F2F4F1;padding:0 8rpx 0 28rpx;transition:background-color .18s var(--ease)}
.dm-field{flex:1;min-width:0;height:84rpx;border:none;background:transparent;padding:0;font-size:30rpx;color:var(--text1)}
.dm-ph{color:var(--text3);opacity:.85}
.dm-bub-img-wrap{max-width:72%;border-radius:26rpx;overflow:hidden}
.dm-bub-img{max-width:100%;border-radius:26rpx;display:block}
.dm-send{flex:0 0 auto;width:68rpx;height:68rpx;border-radius:50%;background:#DDE3DE;display:flex;align-items:center;justify-content:center;transition:background-color .18s var(--ease),transform .12s var(--ease)}
.dm-send.on{background:var(--primary)}
.dm-send:active{transform:scale(.94)}

/* ===== 问答详情（校园问答定位：蓝=问答） ===== */
.qa-q{margin:24rpx 32rpx 0;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);padding:28rpx}
.qq-top{display:flex;align-items:center;gap:16rpx;margin-bottom:16rpx}
/* 「问」是蓝色唯一合法处：sky 实色 + 白字，字重上限 600 */
.qmark-s{width:48rpx;height:48rpx;border-radius:var(--r-md);background:var(--sky);color:#fff;font-weight:600;font-size:26rpx;display:flex;align-items:center;justify-content:center}
.qa-q ._h1{font-size:34rpx;line-height:1.34;font-weight:600;letter-spacing:var(--track-2);text-wrap:balance;color:var(--ink-brush)}
.qa-asker{display:flex;align-items:center;gap:16rpx;margin-top:16rpx}
.qa-asker .av{width:48rpx;height:48rpx;border-radius:50%;font-size:22rpx;display:flex;align-items:center;justify-content:center;font-weight:600}
.qa-asker ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.qa-q .qbody{font-size:28rpx;color:var(--text1);line-height:1.62;margin-top:16rpx;text-wrap:pretty}
.qa-stats{margin-top:24rpx;padding-top:16rpx;border-top:2rpx solid var(--line);font-size:22rpx;color:var(--text-meta);display:flex;gap:16rpx;align-items:center;letter-spacing:0}
.qa-follow{margin-left:auto;height:52rpx;padding:0 24rpx;border-radius:var(--r-full);background:var(--primary-softer);border:2rpx solid var(--line);color:var(--primary-deep);font-size:22rpx;font-weight:500;display:flex;align-items:center}
.qa-follow.done{background:var(--primary-softer);color:var(--primary-deep)}
.qa-sort{display:flex;gap:32rpx;padding:24rpx 40rpx 16rpx;font-size:24rpx;color:var(--text-meta)}
.qa-sort .on{color:var(--text1);font-weight:600}
.ans{margin:0 32rpx 24rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);padding:24rpx 28rpx;transition:transform .12s var(--ease)}
.ans:active{transform:scale(.98)}
.ans-top{display:flex;align-items:center;gap:16rpx}
.ans-top .av{width:56rpx;height:56rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600}
.ans-top ._b{font-size:24rpx;font-weight:500;display:block}
.ans-top ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
/* 采纳标：实色深琥珀 + 白字（例外 E-pick —— 采纳＝盖章，与朱砂印同语汇）
   白色描边勾压在 #9C5C00 上 6.4:1 天然可见，图标保留 ⇒ 采纳/未采纳宽度一致，列表滚动不再横向抖。data-URI 不动 */
.pick{margin-left:auto;flex-shrink:0;height:44rpx;padding:0 16rpx;border-radius:var(--r-full);background:var(--amber-deep);color:#fff;font-size:22rpx;font-weight:600;display:flex;align-items:center;gap:8rpx}
.pick .icu-48{display:inline-block}
.ans ._p{font-size:28rpx;line-height:1.62;color:var(--text1);margin-top:16rpx;text-wrap:pretty}
.ans-acts{display:flex;gap:32rpx;margin-top:24rpx;padding-top:16rpx;border-top:2rpx solid var(--line);font-size:22rpx;color:var(--text-meta);align-items:center;letter-spacing:0}
.qa-bar{position:sticky;bottom:0;background:rgba(255,255,255,.95);-webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx);border-top:2rpx solid var(--line);display:flex;gap:16rpx;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));align-items:center}
.qa-input{flex:1;height:72rpx;border-radius:var(--r-full);background:#F1F4F1;border:2rpx solid var(--line);padding:0 28rpx;font-size:32rpx;color:var(--text1);min-width:0}
.qa-ph{color:var(--text3);opacity:.85}
.qa-pub{height:72rpx;padding:0 32rpx;border-radius:var(--r-full);background:var(--primary);color:#fff;font-size:26rpx;font-weight:600;display:flex;align-items:center;flex-shrink:0;transition:transform .12s var(--ease);position:relative;overflow:hidden}
.qa-pub:active{transform:scale(.96)}

/* ===== 互动消息（赞 / 评论 / 关注） ===== */
.nt-list{padding:8rpx 32rpx 56rpx}
.nt-row{display:flex;gap:20rpx;align-items:center;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-lg);padding:24rpx;margin-bottom:16rpx;transition:transform .12s var(--ease)}
.nt-row:active{transform:scale(.98)}
.nt-ava{width:72rpx;height:72rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:600;flex-shrink:0}
.nt-main{flex:1;min-width:0}
.nt-main ._b{font-size:24rpx;font-weight:500}
.nt-main .what{font-size:24rpx;color:var(--text2);line-height:1.45;margin-top:4rpx}
.nt-main .what ._em{font-style:normal;color:var(--text1);font-weight:600}
.nt-main .tm{font-size:22rpx;color:var(--text-meta);margin-top:4rpx;letter-spacing:0}
.nt-thumb{width:80rpx;height:80rpx;border-radius:var(--r-md);flex-shrink:0;display:flex;align-items:center;justify-content:center}
.nt-act{flex-shrink:0;height:52rpx;padding:0 24rpx;border-radius:var(--r-full);font-size:22rpx;display:flex;align-items:center;font-weight:500}
.nt-act.re{background:var(--primary-softer);color:var(--primary-deep)}
.nt-act.followed{background:var(--bg);color:var(--text-meta);border:2rpx solid var(--line);font-weight:400}

/* ===== AI 学伴（克制版：白底、无光效、素气泡） ===== */

.ai-head{padding:48rpx 32rpx 8rpx;display:flex;align-items:center;gap:24rpx}
/* 返回做成无底裸箭头，与身份图标拉开层级 */

.ai-badge{width:72rpx;height:72rpx;border-radius:var(--r-lg);background:var(--primary-soft);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ai-head ._h1{font-size:44rpx;font-weight:600;line-height:1.28;color:var(--ink-brush);letter-spacing:0}
.ai-head ._p{font-size:22rpx;color:var(--text-meta);margin-top:4rpx;letter-spacing:0}
.hist-row{display:flex;gap:16rpx;padding:4rpx 32rpx 14rpx;overflow-x:auto;scrollbar-width:none}
.hist-row::-webkit-scrollbar{display:none}
.hist{flex-shrink:0;height:62rpx;padding:0 24rpx;border-radius:var(--r-full);background:#F2F4F1;border:2rpx solid transparent;font-size:24rpx;color:var(--text2);display:flex;align-items:center;gap:8rpx;transition:background-color .15s var(--ease)}
.ai-msgs{padding:0}
/* 学伴空态：「今天大家都在问」编辑式问题卡（星标注脚 + 渐隐细线 + 编号 + 按压箭头滑动） */
.ask-list{margin:16rpx 0 24rpx;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-lg);padding:8rpx;max-width:88%}
.ask-head{display:flex;align-items:center;gap:10rpx;padding:16rpx 18rpx 12rpx}
/* 结果样例：首屏先给一次「问完真的能得到什么」，
   比再列三个问题更能说明这个入口的价值。整块可点，直接打开那次对话。 */
.ai-sample{margin:4rpx 0 16rpx;max-width:88%;background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-lg);padding:20rpx 22rpx 18rpx;transition:transform .12s var(--ease)}
.ai-sample:active{transform:scale(.99)}
.as-hd{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.as-t{font-size:24rpx;font-weight:600;color:var(--ink-brush);min-width:0}
.as-go{font-size:22rpx;color:var(--primary-deep);flex-shrink:0}
.as-row{display:flex;align-items:baseline;gap:14rpx;margin-top:12rpx}
.as-d{flex-shrink:0;width:76rpx;padding:3rpx 0;border-radius:var(--r-sm);background:var(--primary-softer);color:var(--primary-deep);font-size:20rpx;font-weight:600;text-align:center;letter-spacing:0}
.as-x{flex:1;min-width:0;font-size:22rpx;line-height:1.5;color:var(--text2)}
.ask-spark{width:24rpx;height:24rpx}
.ask-h{font-size:22rpx;color:var(--primary-deep);letter-spacing:0;font-weight:500}
.ask-head::after{content:"";flex:1;height:1rpx;background:linear-gradient(to right,var(--line),rgba(18,51,59,0))}
.ask-item{position:relative;display:flex;align-items:flex-start;gap:14rpx;padding:20rpx 18rpx;border-radius:var(--r-md);transition:background-color .15s var(--ease)}
.ask-item+.ask-item::before{content:"";position:absolute;top:0;left:68rpx;right:18rpx;height:1rpx;background:var(--line)}
.ask-no{flex-shrink:0;min-width:36rpx;padding-top:4rpx;font-size:22rpx;font-weight:600;color:var(--primary);letter-spacing:0}
.ask-q{flex:1;min-width:0;font-size:24rpx;line-height:1.5;color:var(--text1);font-weight:500;text-wrap:pretty}
.ask-arr{flex-shrink:0;align-self:center;display:flex;transition:transform .2s var(--ease)}
.ask-item.ask-press{background:var(--primary-softer)}
.ask-item.ask-press .ask-no{color:var(--primary-deep)}
.ask-item.ask-press .ask-arr{transform:translateX(6rpx)}
.ask-item.ask-press .icu-45{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2214%22%20height%3D%2214%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230F454F%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M9%205l7%207-7%207%22%2F%3E%3C%2Fsvg%3E")}
/* 学伴输入 dock：随页面流式排版落底（独立页无 TabBar，不再上浮 104rpx） */
.ai-dock{position:relative;flex-shrink:0;background:var(--card);border-top:2rpx solid var(--line);padding:16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:24rpx}
.dock-chips{display:flex;gap:16rpx;overflow-x:auto;scrollbar-width:none}
.dock-chips::-webkit-scrollbar{display:none}
/* 底部快捷话题也用同一套中性胶囊：白底药丸在纯白 dock 上是「隐形」的，点了才知道能点 */
.dock-chips .sug{background:#F2F4F1}
.dock-input{display:flex;padding:0 28rpx}


/* ===== 底部导航 ===== */
/* 底部导航：底白 .96 已接近不透明，24rpx 毛玻璃对画面的贡献只有 4%×局部对比度
   （纯黑白条纹最坏情况下单通道差 6/255），却是滚动时每帧都要重算的全宽高斯模糊；
   去掉 backdrop-filter，视觉无感、滚动省一笔 GPU。其余真玻璃面（.dm-bar/.qa-bar/.sd-panel 等）不动。 */
.tabbar{position:fixed;bottom:0;left:0;right:0;z-index:50;background:rgba(255,255,255,.96);border-top:2rpx solid var(--line);box-shadow:var(--shadow-float);display:flex;padding:16rpx 12rpx calc(16rpx + env(safe-area-inset-bottom));transition:transform .3s var(--ease)}

.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;min-height:88rpx;padding:8rpx 0;color:var(--text-meta);font-size:22rpx;position:relative;letter-spacing:0}
.tab.on{color:var(--primary);font-weight:600}
.tab .tdot{position:absolute;top:0;right:calc(50% - 36rpx);width:16rpx;height:16rpx;border-radius:50%;background:var(--primary)}
.fab-center{position:relative;flex:1;display:flex;align-items:center;justify-content:center;margin-top:1rpx}
/* 主按钮（轻量化 2.0：光池渐变与 4 层 inset 高光下线，实色主色 + 唯一 float 阴影）
   按压只保留 scale，不叠亮度变化；overflow:hidden 裁切圆角 */
.btn-primary{position:relative;overflow:hidden;background:var(--primary);box-shadow:none}
.fab-btn{width:96rpx;height:96rpx;border-radius:50%;position:relative;overflow:hidden;background:var(--primary);box-shadow:var(--shadow-float);display:flex;align-items:center;justify-content:center;border:8rpx solid #fff;transition:transform .18s var(--ease)}
.fab-btn:active{transform:scale(.96)}
/* 学伴（对话沉浸态）隐藏 TabBar，输入 dock 落底 */
.tabbar.hide{transform:translateY(130%)}




/* ===== 半屏发布 ===== */
.mask{position:fixed;inset:0;background:var(--mask);opacity:0;pointer-events:none;transition:opacity .24s var(--ease);z-index:80}
.mask.show{opacity:1;pointer-events:auto}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:90;background:var(--card);border-radius:40rpx 40rpx 0 0;transform:translateY(105%);transition:transform .3s var(--ease);padding:16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));box-shadow:var(--shadow-sheet)}
.sheet.show{transform:translateY(0)}

/* 把手：64×6 比 72×8 更「仪器感」，颜色退到 --line 一档，只做位置提示不抢视线 */
.handle{width:64rpx;height:6rpx;border-radius:var(--r-full);background:#E2E7E2;margin:10rpx auto 26rpx}
.sheet ._h3{font-size:34rpx;font-weight:600;letter-spacing:var(--track-2);text-align:center;color:var(--ink-brush)}
.sheet .sub{font-size:22rpx;color:var(--text-meta);text-align:center;margin-top:8rpx;letter-spacing:0}
.pub-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:28rpx}
.pub{background:var(--card);border:2rpx solid var(--line);border-radius:var(--r-xl);padding:32rpx 28rpx;display:flex;align-items:center;gap:24rpx}
.pub .pi{width:80rpx;height:80rpx;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pub ._b{font-size:24rpx;font-weight:500;display:block}
.pub ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.sheet .note{font-size:22rpx;color:var(--text-meta);text-align:center;margin-top:24rpx;letter-spacing:0}

/* ===== 详情覆盖（帖子详情：吸顶栏明暗翻转——头图区白字透明底 → 滚过头图后墨色字 + 磨砂底，500ms） ===== */
.detail{position:fixed;inset:0;z-index:100;background:var(--bg);overflow-y:auto;transform:translateY(4%);opacity:0;pointer-events:none;transition:transform .26s var(--ease),opacity .26s var(--ease);scrollbar-width:none}
.detail::-webkit-scrollbar{display:none}
.detail.show{transform:none;opacity:1;pointer-events:auto}

.pc-body{height:100vh}
.d-hero{width:100%;height:464rpx}
/* 顶部内边距由 statusBarHeight 注入（env() 在开发者工具为 0，不可单独依赖）；右侧避让胶囊按钮 */
.d-bar{position:fixed;top:0;left:0;right:0;z-index:6;display:flex;align-items:center;gap:16rpx;padding:0 200rpx 16rpx 24rpx;transition:background-color .5s var(--ease),box-shadow .5s var(--ease)}
.d-bar.solid{background:rgba(255,255,255,.65);-webkit-backdrop-filter:blur(18rpx) saturate(1.15);backdrop-filter:blur(18rpx) saturate(1.15);border-bottom:2rpx solid var(--line);box-shadow:none}
.d-close{position:relative;width:72rpx;height:72rpx;border-radius:50%;background:rgba(14,32,24,.32);-webkit-backdrop-filter:blur(12rpx);backdrop-filter:blur(12rpx);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background-color .5s var(--ease)}
.d-close::after{content:"";position:absolute;inset:-8rpx;border-radius:50%}
.d-bar-title{flex:1;min-width:0;font-size:28rpx;font-weight:600;color:var(--ink-brush);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transform:translateY(8rpx);transition:opacity .3s var(--ease),transform .3s var(--ease)}
.d-bar.solid .d-bar-title{opacity:1;transform:none}
.d-body{margin:0 28rpx;background:var(--card);border-radius:var(--r-xl) var(--r-xl) 0 0;padding:32rpx 32rpx 210rpx;position:relative;transform:translateY(-32rpx)}
.d-tag{font-size:22rpx;font-weight:500;color:var(--primary-deep);background:var(--primary-softer);border-radius:var(--r-sm);padding:4rpx 16rpx;display:inline-block;letter-spacing:0}
.d-tags{display:flex;gap:16rpx;margin-top:24rpx}
.d-body ._h1{font-size:34rpx;line-height:1.34;margin:16rpx 0;font-weight:600;letter-spacing:var(--track-2);color:var(--ink-brush);text-wrap:balance}
.d-author{display:flex;align-items:center;gap:16rpx;margin-bottom:24rpx}
.d-author-main{flex:1;min-width:0}
.d-dm{flex-shrink:0;height:52rpx;padding:0 24rpx;border-radius:var(--r-full);border:2rpx solid var(--line);color:var(--primary-deep);font-size:22rpx;font-weight:600;letter-spacing:0;display:flex;align-items:center}
.d-author .av{width:64rpx;height:64rpx;border-radius:50%;background:var(--primary-soft);color:var(--primary-deep);display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:600}
.d-author ._b{font-size:24rpx;font-weight:500;display:block}
.d-author ._s{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
/* 正文 26/400 · 1.6：与 34 的标题、22 的元信息拉开三档，靠尺寸分层而不是加粗 */
.d-body ._p{font-size:26rpx;line-height:1.6;color:var(--text1);text-wrap:pretty}
/* 评论区节奏：标题（L3）与首条评论之间建立明确层级间隔，首屏可见 ≥2 条 */
.d-comments{margin-top:32rpx;padding-top:24rpx;border-top:2rpx solid var(--line)}
.dc-head{display:flex;align-items:baseline;gap:12rpx}
.dc-head ._b{font-size:28rpx;font-weight:600;color:var(--ink-brush)}
.dc-head .dc-count{font-size:22rpx;color:var(--text-meta);letter-spacing:0}
.dc-item{display:flex;gap:16rpx;margin-top:24rpx}
.dc-item .av{width:56rpx;height:56rpx;border-radius:50%;background:var(--primary-soft);color:var(--primary-deep);display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600;flex-shrink:0}
.dc-item .dc-main{flex:1;min-width:0}
.dc-item .dc-top{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.dc-right{display:flex;align-items:baseline;gap:20rpx;flex-shrink:0}
.dc-reply{font-size:22rpx;color:var(--primary-deep);font-weight:500;letter-spacing:0;padding:2rpx 0}
/* 评论点赞：图标 + 数字（0 时隐藏），已赞主绿填色；触控区向外扩 4rpx */
.dc-like{display:flex;align-items:center;gap:4rpx;padding:4rpx;margin:-4rpx;align-self:center;transition:transform .12s var(--ease)}
.dc-like:active{transform:scale(.92)}
.dc-like-num{font-size:22rpx;color:var(--text-meta);letter-spacing:0;line-height:1;transition:color .15s var(--ease)}
.dc-like.on .dc-like-num{color:var(--primary)}
.dc-to{color:var(--primary-deep);font-weight:600}
.dc-item ._b{font-size:24rpx;font-weight:500}
.dc-item ._t{font-size:22rpx;color:var(--text-meta);letter-spacing:0;flex-shrink:0}
.dc-item ._p{font-size:24rpx;line-height:1.62;color:var(--text1);margin-top:4rpx;text-wrap:pretty;word-break:break-all;overflow-wrap:anywhere}
.d-actions{position:fixed;bottom:0;left:0;right:0;background:rgba(255,255,255,.65);-webkit-backdrop-filter:blur(18rpx) saturate(1.15);backdrop-filter:blur(18rpx) saturate(1.15);border-top:2rpx solid var(--line);box-shadow:none;display:flex;flex-direction:column;gap:10rpx;padding:12rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));z-index:6}
.d-acts{display:flex;align-items:center;justify-content:flex-end;gap:32rpx;padding-right:4rpx}
.d-input-row{display:flex;align-items:center;gap:16rpx}
.d-input{flex:1;min-width:0;height:72rpx;line-height:72rpx;border-radius:var(--r-full);background:#F1F4F1;font-size:32rpx;color:var(--text1);padding:0 24rpx}
.d-ph{color:var(--text3);opacity:.85}
.d-send{flex-shrink:0;height:72rpx;padding:0 34rpx;border-radius:var(--r-full);background:var(--primary);color:#fff;font-size:24rpx;font-weight:600;letter-spacing:0;display:flex;align-items:center;transition:background-color .15s var(--ease),transform .12s var(--ease)}
.d-send:active{transform:scale(.96)}
.d-send.disabled{background:rgba(18,51,59,.07);color:var(--text3)}
.d-act{display:flex;flex-direction:row;align-items:center;gap:8rpx;font-size:22rpx;color:var(--text-meta);letter-spacing:0;transition:transform .12s var(--ease),color .15s var(--ease)}
.d-act:active{transform:scale(.96)}
/* 已赞/已收藏：主绿填色图标 + 主绿数字；未操作：线性灰图标 */
.d-act.on{color:var(--primary)}
.d-act .d-num{display:inline-block}
/* 点赞数字回弹（--ease-spring 指定场景，180ms，峰值 1.18） */
.d-act .d-num.pop{animation:numpop .18s var(--ease-spring)}
@keyframes numpop{0%{transform:scale(1.18)}100%{transform:scale(1)}}

/* ===== AI 对话（极简聊天） ===== */
.chat{position:fixed;inset:0;z-index:110;background:var(--card);display:flex;flex-direction:column;transform:translateY(100%);opacity:0;pointer-events:none;transition:transform .3s var(--ease),opacity .2s var(--ease)}
.chat.show{transform:translateY(0);opacity:1;pointer-events:auto}

.chat-head{display:flex;align-items:center;gap:16rpx;padding:24rpx 28rpx;background:var(--card);border-bottom:1rpx solid var(--line);flex-shrink:0}
.chat-back{position:relative;width:72rpx;height:72rpx;border-radius:50%;background:var(--card);border:2rpx solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--primary-deep);flex-shrink:0;transition:transform .12s var(--ease),border-color .15s var(--ease)}
.chat-back::after{content:"";position:absolute;inset:-8rpx;border-radius:50%}
.chat-head ._b{font-size:28rpx;display:block;font-weight:600}
.chat-head ._s{font-size:22rpx;color:var(--text-meta);display:block;margin-top:2rpx;letter-spacing:0}
.chat-msgs{flex:1;overflow-y:auto;scrollbar-width:none}
.chat-msgs::-webkit-scrollbar{display:none}
.row{display:flex;margin-bottom:20rpx;gap:16rpx;align-items:flex-start}
.row.user{justify-content:flex-end}
/* 气泡几何照 iOS Messages：主圆角 34rpx，指向头像的那一角收成 10rpx。
   气泡一律无描边、无投影，只靠底色和白纸分开——加描边就把它读成「卡片」，
   这是这两页此前最不像苹果的地方。 */
.col{max-width:74%;min-width:0;display:flex;flex-direction:column;gap:12rpx}
.bubble{max-width:74%;border-radius:34rpx;padding:16rpx 26rpx;font-size:30rpx;line-height:1.5}
.col .bubble{max-width:100%}
.row.ai .bubble{background:#EDF0EC;color:var(--text1);border-top-left-radius:10rpx}
/* 用户气泡走一档极浅的上下渐变：iMessage 的蓝也不是纯色，纯色会显得「平」 */
.row.user .bubble{background:linear-gradient(180deg,#1B787D 0%,#156167 100%);color:#fff;border-top-right-radius:10rpx;letter-spacing:0}
/* 对话头像：AI 为圆角方徽（与页头学伴徽标同源），用户为圆头像；底对齐不随长气泡拉伸 */
.row-ava{width:56rpx;height:56rpx;border-radius:var(--r-lg);background:var(--primary-soft);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;color:var(--primary-deep)}
.row-ava.me{border-radius:50%}
.row-ava .icu-ai{width:30rpx;height:30rpx}
.row-ava .row-ava-img{width:100%;height:100%;display:block}
/* 结构化答案：标签不用彩色胶囊，改成加粗的中文字头 + 正文顺排。
   三个字固定 96rpx 宽度让描述左缘对齐，读起来是一段「排过版的话」而不是一张表格。 */
.plan{margin-top:18rpx;display:flex;flex-direction:column;gap:14rpx}
.plan .pv{display:flex;gap:14rpx;align-items:flex-start;font-size:26rpx;line-height:1.55}
.plan ._b{flex:0 0 auto;min-width:96rpx;font-size:26rpx;line-height:1.55;font-weight:600;color:var(--primary-deep);letter-spacing:0}
/* 站内引用 = 附件卡：从气泡里拿出来，浮在气泡下方（iMessage 的附件也从不嵌在气泡内） */
.att{background:var(--card);border:1rpx solid var(--line);border-radius:26rpx;overflow:hidden}
.att-r{display:flex;align-items:center;gap:16rpx;padding:18rpx 20rpx;position:relative}
.att-r+.att-r::before{content:"";position:absolute;left:78rpx;right:0;top:0;height:1rpx;background:var(--line-soft)}
.att-f{width:48rpx;height:48rpx;border-radius:12rpx;background:var(--primary-softer);color:var(--primary-deep);font-size:16rpx;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0;letter-spacing:0}
.att-l{flex:1;min-width:0;font-size:24rpx;color:var(--text1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sugs{display:flex;gap:16rpx;padding:16rpx 28rpx;overflow-x:auto;scrollbar-width:none;flex-shrink:0}
.sugs::-webkit-scrollbar{display:none}
.sug{flex-shrink:0;height:60rpx;padding:0 24rpx;border-radius:var(--r-full);background:#F2F4F1;border:2rpx solid transparent;font-size:24rpx;color:var(--text2);display:flex;align-items:center;transition:background-color .15s var(--ease)}
/* 输入药丸：输入框无描边、发送键收进药丸右侧（iMessage 的发送键就在输入框里面）。
   空态是灰底灰箭头，有字才亮成主色——状态自己说话，不用另加提示。 */
.chat-input{display:flex;padding:14rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--card);border-top:1rpx solid var(--line);flex-shrink:0}
.pill-input{flex:1;min-width:0;display:flex;align-items:center;height:88rpx;border-radius:var(--r-full);background:#F2F4F1;padding:0 8rpx 0 30rpx;transition:background-color .18s var(--ease)}
.pill-input.on{background:#EAEEEA}
.pill-input ._input{flex:1;min-width:0;height:88rpx;border:none;background:transparent;padding:0;font-size:30rpx;color:var(--text1);outline:none}
.pill-input input::placeholder{color:var(--text3);opacity:.85}
.pill-input .send{width:68rpx;height:68rpx;border-radius:50%;background:#DDE3DE;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background-color .18s var(--ease),transform .12s var(--ease)}
.pill-input .send.on{background:var(--primary)}
.pill-input .send:active{transform:scale(.94)}
.typing{display:inline-flex;gap:8rpx;padding:8rpx 4rpx}
.typing ._i{width:12rpx;height:12rpx;border-radius:50%;background:var(--text3);animation:tp 1s infinite}

@keyframes tp{30%{transform:translateY(1rpx);opacity:.45}}

/* toast */
.toast{position:fixed;left:50%;bottom:216rpx;transform:translateX(-50%) translateY(16rpx);background:rgba(38,51,49,.92);color:#fff;font-size:24rpx;font-weight:500;padding:16rpx 32rpx;border-radius:var(--r-full);opacity:0;transition:opacity .25s var(--ease),transform .25s var(--ease);z-index:120;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1;transform:translateX(-50%)}

/* ===== 精致度细节：触感反馈 / 热区 / 排版 ===== */
/* 统计栏（.icard）不再整格缩放：缩三分之一格会在圆角容器里露缝，按压反馈改底色 press-bg */
.hcard,.pub,.feed-row,.conv,.mrow,.mc,.ach,.join-pill{transition:transform .12s var(--ease)}
.hcard:active,.pub:active,.feed-row:active,.conv:active,.mrow:active{transform:scale(.98)}
.mc:active,.ach:active,.join-pill:active{transform:scale(.96)}
.sug{position:relative;transition:transform .12s var(--ease),background-color .15s var(--ease)}
.sug:active{transform:scale(.96)}
.sug::after{content:"";position:absolute;left:1rpx;right:1rpx;top:1rpx;bottom:1rpx}
.hist{position:relative}
.hist::after{content:"";position:absolute;left:1rpx;right:1rpx;top:1rpx;bottom:1rpx}
.ask-item{transition:background-color .15s var(--ease)}
.sec-title ._b,.d-body ._h1,.chat-head ._b{text-wrap:balance}
.d-body ._p,.bubble{text-wrap:pretty}


